{
  "name": "klas-plus-webview",
  "version": "26.03.02",
  "private": true,
  "workspaces": [
    "workers/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "agent:dev": "npm run dev --workspace @klas-plus/agent-api",
    "agent:deploy": "npm run deploy --workspace @klas-plus/agent-api",
    "agent:typecheck": "npm run typecheck --workspace @klas-plus/agent-api",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@egjs/react-flicking": "^4.14.0",
    "@opennextjs/cloudflare": "^1.19.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@reacticons/ionicons": "^7.1.0",
    "@tailwindcss/postcss": "^4.1.13",
    "autoprefixer": "^10.4.21",
    "border-beam": "^1.3.0",
    "chart.js": "^4.4.3",
    "framer-motion": "^11.9.0",
    "jsdom": "^24.1.1",
    "mathjs": "^15.2.0",
    "moment": "^2.30.1",
    "next": "16.3.0",
    "node-html-parser": "^6.1.13",
    "postcss": "^8.5.23",
    "pulltorefreshjs": "^0.1.22",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-big-calendar": "^1.15.0",
    "react-chartjs-2": "^5.2.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.1.13",
    "thinking-orbs": "^0.3.1",
    "turndown": "^7.2.0",
    "use-pull-to-refresh": "^2.4.1",
    "vaul": "^1.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "19.2.3",
    "typescript": "5.5.2",
    "wrangler": "^4.122.0",
    "yarn-audit-fix": "^11.0.4"
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.0",
    "undici": "^7.18.2",
    "@smithy/config-resolver": "^4.4.6"
  },
  "resolutions": {
    "react": "^19.2.3",
    "react-dom": "^19.2.0",
    "undici": "^7.18.2",
    "@smithy/config-resolver": "^4.4.6"
  }
}
